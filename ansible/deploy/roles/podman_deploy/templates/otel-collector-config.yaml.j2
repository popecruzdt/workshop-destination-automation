# otel-collector-config.yaml
# Generated by Ansible podman_deploy role from templates/otel-collector-config.yaml.j2.
# To use a fully static configuration instead, set otel_collector_custom_config: true
# and edit app/opentelemetry/custom-otel-collector-config.yaml directly.
#
# Export modes:
#   - Dynatrace traces export (otel_collector_dynatrace_export_traces) is only enabled when OneAgent
#     is NOT deployed; with OneAgent, the agent captures the app's OpenTelemetry spans itself.
#   - Arize AX traces export (otel_collector_arize_export) is independent of the Dynatrace export
#     and works with or without OneAgent.

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
  prometheus:
    config:
      scrape_configs:
        - job_name: weaviate
          scrape_interval: 15s
          static_configs:
            - targets: ['weaviate:2112']

processors:
  batch:
    timeout: 10s
    send_batch_size: 1024
  cumulativetodelta:
  # Identifies telemetry from this workshop on the OTLP path; the Dynatrace OpenPipeline OTLP
  # routes match on service.namespace (OneAgent-captured spans are routed by host group instead).
  resource/destination-automation:
    attributes:
      - key: service.namespace
        value: "{{ otel_collector_service_namespace }}"
        action: insert

exporters:
  debug:
{% if otel_collector_dynatrace_export | bool %}
  otlphttp/dynatrace:
    endpoint: "{{ otel_collector_dynatrace_endpoint }}"
    headers:
      Authorization: "Api-Token {{ otel_collector_dynatrace_token }}"
{% endif %}
{% if otel_collector_arize_export | bool %}
  otlp/arize:
    endpoint: "{{ otel_collector_arize_endpoint }}"
    headers:
      arize-space-id: "{{ otel_collector_arize_space_id }}"
      arize-api-key: "{{ otel_collector_arize_api_key }}"
{% endif %}

service:
  telemetry:
    logs:
      level: "info"
      encoding: "json"
    metrics:
      level: "detailed"
      readers:
        - periodic:
            interval: 10000
            timeout: 5000
            exporter:
              otlp:
                protocol: http/protobuf
                temporality_preference: delta
                endpoint: "http://localhost:4318/v1/metrics"
  pipelines:
    traces:
      receivers: [otlp]
      processors: [resource/destination-automation, batch]
      exporters:
        - debug
{% if otel_collector_dynatrace_export | bool and otel_collector_dynatrace_export_traces | bool %}
        - otlphttp/dynatrace
{% endif %}
{% if otel_collector_arize_export | bool %}
        - otlp/arize
{% endif %}
    metrics:
      receivers: [otlp, prometheus]
      processors: [resource/destination-automation, cumulativetodelta, batch]
      exporters:
        - debug
{% if otel_collector_dynatrace_export | bool and otel_collector_dynatrace_export_metrics | bool %}
        - otlphttp/dynatrace
{% endif %}
    logs:
      receivers: [otlp]
      processors: [resource/destination-automation, batch]
      exporters:
        - debug
{% if otel_collector_dynatrace_export | bool and otel_collector_dynatrace_export_logs | bool %}
        - otlphttp/dynatrace
{% endif %}

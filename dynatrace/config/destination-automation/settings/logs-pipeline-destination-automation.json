{
  "metadataList": [],
  "customId": "pipeline_destination-automation-logs_8401",
  "displayName": "destination-automation-logs",
  "processing": {
    "processors": [
      {
        "id": "processor_Container_Syslog_Content_6342",
        "enabled": true,
        "description": "Container Syslog Content",
        "type": "dql",
        "matcher": "matchesValue(log.source,\"/var/log/messages\") and matchesPhrase(content,\"name\") and matchesPhrase(content,\"message\") and matchesPhrase(content,\"level\")",
        "dql": {
            "script": "parse content, \"LD JSON:nested_content\"\n| fieldsAdd name = nested_content[`name`], message = nested_content[`message`], loglevel = upper(nested_content[`level`])"
        }
      }
    ]
  },
  "securityContext": {
    "processors": []
  },
  "costAllocation": {
    "processors": []
  },
  "productAllocation": {
    "processors": []
  },
  "storage": {
    "processors": []
  },
  "smartscapeNodeExtraction": {
    "processors": []
  },
  "smartscapeEdgeExtraction": {
    "processors": []
  },
  "metricExtraction": {
    "processors": []
  },
  "davis": {
    "processors": [
      {
        "id": "feature-flag-change-event",
        "enabled": true,
        "description": "Davis event for OpenFeature flag changes emitted by the app as OTel log records (feature_flag.change). Linked to the process via dt.source_entity when OneAgent metadata is on the record; always carries service.name.",
        "type": "davis",
        "matcher": "isNotNull(feature_flag.key) and matchesValue(otel.scope.name, \"ai-travel-advisor.feature-flags\")",
        "davis": {
          "properties": [
            {
              "key": "event.type",
              "value": "CUSTOM_CONFIGURATION"
            },
            {
              "key": "event.name",
              "value": "{content}"
            },
            {
              "key": "event.description",
              "value": "{content}"
            },
            {
              "key": "service.name",
              "value": "{service.name}"
            },
            {
              "key": "feature_flag.key",
              "value": "{feature_flag.key}"
            },
            {
              "key": "feature_flag.previous_value",
              "value": "{feature_flag.previous_value}"
            },
            {
              "key": "feature_flag.result.value",
              "value": "{feature_flag.result.value}"
            },
            {
              "key": "feature_flag.result.variant",
              "value": "{feature_flag.result.variant}"
            },
            {
              "key": "feature_flag.result.enabled",
              "value": "{feature_flag.result.enabled}"
            }
          ]
        }
      }
    ]
  },
  "dataExtraction": {
    "processors": []
  }
}
